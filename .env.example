# 应用环境：development / production
APP_ENV=development

# HTTP 监听地址（留空时：开发 127.0.0.1:8080，生产 :8080）
HTTP_ADDR=127.0.0.1:8080

# MySQL 连接串
MYSQL_DSN=root:123456@tcp(127.0.0.1:3306)/weiyu?charset=utf8mb4&parseTime=True&loc=Local

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ
RABBITMQ_URL=amqp://weiyu:weiyu123456@127.0.0.1:5672/

# JWT 签名密钥，必须 >= 32 字节，生产环境务必更换
JWT_SECRET=please-change-me-to-a-random-secret-32bytes
